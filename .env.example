# Administrador criado (ou redefinido) na subida. Sem estas três, nenhum é criado.
APP_ADMIN_NAME=Administrador
APP_ADMIN_EMAIL=admin@escritorio.local
APP_ADMIN_PASSWORD=troque-por-uma-senha-forte

# Produção com PostgreSQL. Sem estas variáveis, usa H2 em ./data.
DB_URL=jdbc:postgresql://localhost:5432/agenda_juridica
DB_USERNAME=postgres
DB_PASSWORD=sua_senha
DB_DRIVER=org.postgresql.Driver
FLYWAY_ENABLED=true
JPA_DDL_AUTO=validate
SESSION_COOKIE_SECURE=true

APP_DASHBOARD_UPCOMING_DAYS=3
